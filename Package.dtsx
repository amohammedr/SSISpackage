  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Clasify Ledger"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{73A2BE05-AF5D-49A8-876A-95170616A118}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Clasify Ledger"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:SqlStatementSource="INSERT INTO migration.DocumentTransfer&#xA;(&#xA;    SourceDocumentID, SourceParentKind, SourceParentID, LegacyEntityID,&#xA;    SourceFileName, SourceFilePath, DocumentDescription, DocumentExtension,&#xA;    SourceContentKind, SourceDocumentTypeID, SourceDocumentTypeName,&#xA;    ContentSHA256, ContentBytes, SourceCreatedBy, SourceDateCreated,&#xA;    IsArchived, IsDeleted, FileStatus, ParentRoute,&#xA;    MigrationStatus, StatusReason&#xA;)&#xA;SELECT&#xA;    s.SourceDocumentID, s.SourceParentKind, s.SourceParentID, s.LegacyEntityID,&#xA;    s.SourceFileName, s.SourceFilePath, s.DocumentDescription, s.DocumentExtension,&#xA;    s.SourceContentKind, s.SourceDocumentTypeID, s.SourceDocumentTypeName,&#xA;    s.ContentSHA256, s.ContentBytes, s.SourceCreatedBy, s.SourceDateCreated,&#xA;    s.IsArchived, s.IsDeleted, s.FileStatus, s.ParentRoute,&#xA;    'Staged', NULL&#xA;FROM migration.DocumentTransferStage AS s&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM migration.DocumentTransfer AS t&#xA;    WHERE t.SourceDocumentID = s.SourceDocumentID&#xA;      AND t.SourceParentKind = s.SourceParentKind&#xA;      AND t.SourceParentID = s.SourceParentID&#xA;);&#xA;&#xA;UPDATE t&#xA;SET LegacyDocTypeID = dt.DocType_ID&#xA;FROM migration.DocumentTransfer AS t&#xA;JOIN dbo.tblDocumentTypes AS dt&#xA;    ON dt.DocType_Description = t.SourceDocumentTypeName&#xA;WHERE t.MigrationStatus = 'Staged';&#xA;&#xA;UPDATE migration.DocumentTransfer&#xA;SET MigrationStatus = 'SkippedDeleted',&#xA;    StatusReason = 'Deleted in EHD 3.0'&#xA;WHERE MigrationStatus = 'Staged' AND IsDeleted = 1;&#xA;&#xA;UPDATE migration.DocumentTransfer&#xA;SET MigrationStatus = 'SkippedEhd2',&#xA;    StatusReason = 'Legacy share pointer, not an uploaded 3.0 file'&#xA;WHERE MigrationStatus = 'Staged' AND SourceContentKind = 'Ehd2Share';&#xA;&#xA;UPDATE migration.DocumentTransfer&#xA;SET MigrationStatus = 'SkippedExtension',&#xA;    StatusReason = 'Blocked extension'&#xA;WHERE MigrationStatus = 'Staged'&#xA;  AND DocumentExtension IN ('.exe', '.dll', '.bat');&#xA;&#xA;UPDATE migration.DocumentTransfer&#xA;SET MigrationStatus = 'SkippedNoParent',&#xA;    StatusReason = 'No permit or entity on the inspection chain'&#xA;WHERE MigrationStatus = 'Staged'&#xA;  AND (SourceParentKind = 'U' OR LegacyEntityID IS NULL AND SourceParentKind &lt;&gt; 'N');&#xA;&#xA;UPDATE migration.DocumentTransfer&#xA;SET MigrationStatus = 'SkippedComplaint',&#xA;    StatusReason = '3.0 complaint id is not a 1.0 nuisance id'&#xA;WHERE MigrationStatus = 'Staged' AND SourceParentKind = 'N';&#xA;&#xA;UPDATE t&#xA;SET MigrationStatus = 'SkippedNoEntity',&#xA;    StatusReason = 'Entity id is not in tblEntity'&#xA;FROM migration.DocumentTransfer AS t&#xA;WHERE t.MigrationStatus = 'Staged'&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1 FROM dbo.tblEntity AS e WHERE e.EntityID = t.LegacyEntityID&#xA;  );&#xA;&#xA;UPDATE migration.DocumentTransfer&#xA;SET MigrationStatus = 'SkippedNoType',&#xA;    StatusReason = 'No legacy document type with this name'&#xA;WHERE MigrationStatus = 'Staged' AND LegacyDocTypeID IS NULL;&#xA;&#xA;UPDATE migration.DocumentTransfer&#xA;SET MigrationStatus = 'Ready',&#xA;    StatusReason = NULL&#xA;WHERE MigrationStatus = 'Staged';&#xA;&#xA;;WITH Ranked AS&#xA;(&#xA;    SELECT&#xA;        TransferID,&#xA;        ROW_NUMBER() OVER&#xA;        (&#xA;            PARTITION BY LegacyEntityID, ContentSHA256&#xA;            ORDER BY SourceDateCreated, SourceDocumentID&#xA;        ) AS rn&#xA;    FROM migration.DocumentTransfer&#xA;    WHERE MigrationStatus = 'Ready'&#xA;      AND SourceContentKind = 'SqlBlob'&#xA;      AND ContentSHA256 IS NOT NULL&#xA;)&#xA;UPDATE t&#xA;SET MigrationStatus = 'SkippedDuplicate',&#xA;    StatusReason = 'Same file contents already kept for this entity'&#xA;FROM migration.DocumentTransfer AS t&#xA;JOIN Ranked AS r ON r.TransferID = t.TransferID&#xA;WHERE r.rn &gt; 1;&#xA;&#xA;UPDATE t&#xA;SET MigrationStatus = 'Loaded',&#xA;    LegacyDocumentID = t.SourceDocumentID,&#xA;    StatusReason = 'Link already exists'&#xA;FROM migration.DocumentTransfer AS t&#xA;JOIN dbo.tblEntityDocument AS ed&#xA;    ON ed.Document_ID = t.SourceDocumentID&#xA;   AND ed.Entity_ID = t.LegacyEntityID&#xA;WHERE t.MigrationStatus = 'Ready';&#xA;Then run this in SSMS and keep the result:&#xA;&#xA;SELECT MigrationStatus, SourceContentKind, COUNT(*) AS Rows&#xA;FROM migration.DocumentTransfer&#xA;GROUP BY MigrationStatus, SourceContentKind&#xA;ORDER BY MigrationStatus, SourceContentKind;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Clear Working Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3EA3C1BD-A171-42EF-8AB0-86B55FD9052C}"
