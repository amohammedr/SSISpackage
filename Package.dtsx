      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{29639570-B262-417B-81C2-6B414AD57543}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE migration.DocumentTransferStage;&#x9;TRUNCATE TABLE migration.Filestage;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Link SQL Blobs"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D2A06D9E-D96E-4E1B-BB03-5E01938C1BD8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Link SQL Blobs"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{29639570-B262-417B-81C2-6B414AD57543}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.tblEntityDocument&#xA;(&#xA;    Entity_ID, Document_ID, DocType_ID, DocNotes,&#xA;    isRequired, isAdmin, isArchived,&#xA;    CreatedBy, CreatedDate, SourceID&#xA;)&#xA;SELECT&#xA;    t.LegacyEntityID,&#xA;    t.SourceDocumentID,&#xA;    t.LegacyDocTypeID,&#xA;    NULL,&#xA;    0,&#xA;    0,&#xA;    t.IsArchived,&#xA;    LEFT(t.SourceCreatedBy, 50),&#xA;    COALESCE(t.SourceDateCreated, GETDATE()),&#xA;    'E'&#xA;FROM migration.DocumentTransfer AS t&#xA;JOIN dbo.tblDocuments AS d&#xA;    ON d.Document_ID = t.SourceDocumentID&#xA;WHERE t.MigrationStatus = 'Ready'&#xA;  AND t.SourceContentKind = 'SqlBlob'&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM dbo.tblEntityDocument AS ed&#xA;      WHERE ed.Document_ID = t.SourceDocumentID&#xA;        AND ed.Entity_ID = t.LegacyEntityID&#xA;  );&#xA;&#xA;UPDATE t&#xA;SET MigrationStatus = 'Loaded',&#xA;    LegacyDocumentID = t.SourceDocumentID,&#xA;    LegacyEntityDocID = ed.EntityDoc_ID,&#xA;    LastUpdatedUtc = SYSUTCDATETIME()&#xA;FROM migration.DocumentTransfer AS t&#xA;JOIN dbo.tblEntityDocument AS ed&#xA;    ON ed.Document_ID = t.SourceDocumentID&#xA;   AND ed.Entity_ID = t.LegacyEntityID&#xA;WHERE t.MigrationStatus = 'Ready'&#xA;  AND t.SourceContentKind = 'SqlBlob';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load disk files and reconcile"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3C65B9F8-A379-4686-A3C5-C571008891F3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load disk files and reconcile"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{29639570-B262-417B-81C2-6B414AD57543}"
          SQLTask:SqlStatementSource="UPDATE s&#xA;SET ContentSHA256 = CONVERT(char(64), HASHBYTES('SHA2_256', s.DocumentBytes), 2)&#xA;FROM migration.FileStage AS s;&#xA;&#xA;;WITH Ranked AS&#xA;(&#xA;    SELECT&#xA;        t.TransferID,&#xA;        ROW_NUMBER() OVER&#xA;        (&#xA;            PARTITION BY t.LegacyEntityID, s.ContentSHA256&#xA;            ORDER BY t.SourceDateCreated, t.SourceDocumentID&#xA;        ) AS rn&#xA;    FROM migration.DocumentTransfer AS t&#xA;    JOIN migration.FileStage AS s ON s.SourceDocumentID = t.SourceDocumentID&#xA;    WHERE t.MigrationStatus = 'Ready'&#xA;      AND t.SourceContentKind = 'FilePath'&#xA;)&#xA;UPDATE t&#xA;SET MigrationStatus = 'SkippedDuplicate',&#xA;    StatusReason = 'Same file contents already kept for this entity',&#xA;    ContentSHA256 = s.ContentSHA256&#xA;FROM migration.DocumentTransfer AS t&#xA;JOIN Ranked AS r ON r.TransferID = t.TransferID&#xA;JOIN migration.FileStage AS s ON s.SourceDocumentID = t.SourceDocumentID&#xA;WHERE r.rn &gt; 1;&#xA;&#xA;UPDATE t&#xA;SET ContentSHA256 = s.ContentSHA256&#xA;FROM migration.DocumentTransfer AS t&#xA;JOIN migration.FileStage AS s ON s.SourceDocumentID = t.SourceDocumentID&#xA;WHERE t.MigrationStatus = 'Ready';&#xA;&#xA;INSERT INTO dbo.tblDocuments&#xA;(&#xA;    Document_ID, Document_Description, Document_Extension,&#xA;    Document, created_by, created_date, File_Status&#xA;)&#xA;SELECT&#xA;    t.SourceDocumentID,&#xA;    t.DocumentDescription,&#xA;    t.DocumentExtension,&#xA;    s.DocumentBytes,&#xA;    LEFT(t.SourceCreatedBy, 50),&#xA;    COALESCE(t.SourceDateCreated, GETDATE()),&#xA;    t.FileStatus&#xA;FROM migration.FileStage AS s&#xA;JOIN migration.DocumentTransfer AS t&#xA;    ON t.SourceDocumentID = s.SourceDocumentID&#xA;WHERE t.MigrationStatus = 'Ready'&#xA;  AND t.SourceContentKind = 'FilePath'&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1 FROM dbo.tblDocuments AS d&#xA;      WHERE d.Document_ID = t.SourceDocumentID&#xA;  );&#xA;&#xA;INSERT INTO dbo.tblEntityDocument&#xA;(&#xA;    Entity_ID, Document_ID, DocType_ID, DocNotes,&#xA;    isRequired, isAdmin, isArchived,&#xA;    CreatedBy, CreatedDate, SourceID&#xA;)&#xA;SELECT&#xA;    t.LegacyEntityID, t.SourceDocumentID, t.LegacyDocTypeID, NULL,&#xA;    0, 0, t.IsArchived,&#xA;    LEFT(t.SourceCreatedBy, 50),&#xA;    COALESCE(t.SourceDateCreated, GETDATE()),&#xA;    'E'&#xA;FROM migration.DocumentTransfer AS t&#xA;JOIN dbo.tblDocuments AS d ON d.Document_ID = t.SourceDocumentID&#xA;WHERE t.MigrationStatus = 'Ready'&#xA;  AND t.SourceContentKind = 'FilePath'&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1 FROM dbo.tblEntityDocument AS ed&#xA;      WHERE ed.Document_ID = t.SourceDocumentID&#xA;        AND ed.Entity_ID = t.LegacyEntityID&#xA;  );&#xA;&#xA;UPDATE t&#xA;SET MigrationStatus = 'Loaded',&#xA;    LegacyDocumentID = t.SourceDocumentID,&#xA;    LegacyEntityDocID = ed.EntityDoc_ID,&#xA;    LastUpdatedUtc = SYSUTCDATETIME()&#xA;FROM migration.DocumentTransfer AS t&#xA;JOIN dbo.tblEntityDocument AS ed&#xA;    ON ed.Document_ID = t.SourceDocumentID&#xA;   AND ed.Entity_ID = t.LegacyEntityID&#xA;WHERE t.MigrationStatus = 'Ready'&#xA;  AND t.SourceContentKind = 'FilePath';&#xA;&#xA;UPDATE migration.DocumentTransfer&#xA;SET MigrationStatus = 'SkippedUnreadable',&#xA;    StatusReason = 'File path could not be read from this machine'&#xA;WHERE MigrationStatus = 'Ready'&#xA;  AND SourceContentKind = 'FilePath'&#xA;  AND LegacyDocumentID IS NULL;&#xA;&#xA;SELECT MigrationStatus, SourceContentKind, COUNT(*) AS Rows&#xA;FROM migration.DocumentTransfer&#xA;GROUP BY MigrationStatus, SourceContentKind&#xA;ORDER BY MigrationStatus, SourceContentKind;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Manifest"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{4DFD8844-AF91-4E95-B605-F6BE57A5DCCF}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Manifest"
      DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\Load Manifest\OLE DB Destination"
              componentClassID="Microsoft.OLEDBDestination"
              contactInfo="OLE DB Destination;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
              description="OLE DB Destination"
              name="OLE DB Destination"
              usesDispositions="true"
              version="4">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[tblDocuments]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">3</property>
                <property
                  dataType="System.Boolean"
                  description="Indicates whether the values supplied for identity columns will be copied to the destination. If false, values for identity columns will be auto-generated at the destination. Applies only if fast load is turned on."
                  name="FastLoadKeepIdentity">false</property>
                <property
                  dataType="System.Boolean"
                  description="Indicates whether the columns containing null will have null inserted in the destination. If false, columns containing null will have their default values inserted at the destination. Applies only if fast load is turned on."
                  name="FastLoadKeepNulls">false</property>
                <property
                  dataType="System.String"
                  description="Specifies options to be used with fast load.  Applies only if fast load is turned on."
                  name="FastLoadOptions">TABLOCK,CHECK_CONSTRAINTS</property>
                <property
                  dataType="System.Int32"
                  description="Specifies when commits are issued during data insertion.  A value of 0 specifies that one commit will be issued at the end of data insertion.  Applies only if fast load is turned on."
                  name="FastLoadMaxInsertCommitSize">2147483647</property>
              </properties>
              <connections>
                <connection
                  refId="Package\Load Manifest\OLE DB Destination.Connections[OleDbConnection]"
                  connectionManagerID="Package.ConnectionManagers[DCHP00DDBS011.EHD_Test]"
                  connectionManagerRefId="Package.ConnectionManagers[DCHP00DDBS011.EHD_Test]"
                  description="The OLE DB runtime connection used to access the database."
                  name="OleDbConnection" />
              </connections>
              <inputs>
                <input
                  refId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input]"
                  errorOrTruncationOperation="Insert"
                  errorRowDisposition="FailComponent"
                  hasSideEffects="true"
                  name="OLE DB Destination Input">
                  <externalMetadataColumns
                    isUsed="True">
                    <externalMetadataColumn
                      refId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[Document_ID]"
                      dataType="guid"
                      name="Document_ID" />
                    <externalMetadataColumn
                      refId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[Document_Description]"
                      dataType="wstr"
                      length="255"
                      name="Document_Description" />
                    <externalMetadataColumn
                      refId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[Document_Extension]"
                      dataType="wstr"
                      length="25"
                      name="Document_Extension" />
                    <externalMetadataColumn
                      refId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[Document]"
                      dataType="image"
                      name="Document" />
                    <externalMetadataColumn
                      refId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[created_by]"
                      codePage="1252"
                      dataType="str"
                      length="50"
                      name="created_by" />
                    <externalMetadataColumn
                      refId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[created_date]"
                      dataType="dbTimeStamp"
                      name="created_date" />
                    <externalMetadataColumn
                      refId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[Archive_Date]"
                      dataType="dbTimeStamp"
                      name="Archive_Date" />
                    <externalMetadataColumn
                      refId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[File_Status]"
                      dataType="i4"
                      name="File_Status" />
                  </externalMetadataColumns>
                </input>
              </inputs>
              <outputs>
                <output
                  refId="Package\Load Manifest\OLE DB Destination.Outputs[OLE DB Destination Error Output]"
                  exclusionGroup="1"
                  isErrorOut="true"
                  name="OLE DB Destination Error Output"
                  synchronousInputId="Package\Load Manifest\OLE DB Destination.Inputs[OLE DB Destination Input]">
                  <outputColumns>
                    <outputColumn
                      refId="Package\Load Manifest\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorCode]"
                      dataType="i4"
                      lineageId="Package\Load Manifest\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorCode]"
                      name="ErrorCode"
                      specialFlags="1" />
                    <outputColumn
                      refId="Package\Load Manifest\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorColumn]"
                      dataType="i4"
                      lineageId="Package\Load Manifest\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorColumn]"
                      name="ErrorColumn"
                      specialFlags="2" />
                  </outputColumns>
                  <externalMetadataColumns />
                </output>
              </outputs>
            </component>
            <component
              refId="Package\Load Manifest\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[ehd].[Document]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH Parents AS
(
    SELECT d.DocumentID, 'E' AS SourceParentKind,
           CONVERT(varchar(40), p.EntityId) AS SourceParentID,
           CONVERT(bigint, p.EntityId) AS LegacyEntityID,
           'Inspection-Permit-Entity' AS ParentRoute
    FROM ehd.Document AS d
    JOIN ehd.Inspection AS i ON i.InspectionID = d.InspectionID
    JOIN ehd.Permit AS p ON p.PermitID = i.PermitID
    WHERE p.EntityId IS NOT NULL

    UNION ALL
    SELECT d.DocumentID, 'E', CONVERT(varchar(40), d.EHD2EntityID),
           CONVERT(bigint, d.EHD2EntityID), 'EHD2EntityID'
    FROM ehd.Document AS d
    WHERE d.EHD2EntityID IS NOT NULL

    UNION ALL
    SELECT d.DocumentID, 'E', CONVERT(varchar(40), p.EntityId),
           CONVERT(bigint, p.EntityId), 'PermitDocument'
    FROM ehd.Document AS d
    JOIN ehd.PermitDocument AS x ON x.DocumentID = d.DocumentID
    JOIN ehd.Permit AS p ON p.PermitID = x.PermitID
    WHERE p.EntityId IS NOT NULL

    UNION ALL
    SELECT d.DocumentID, 'E', CONVERT(varchar(40), p.EntityId),
           CONVERT(bigint, p.EntityId), 'InspectionDocument'
    FROM ehd.Document AS d
    JOIN ehd.InspectionDocument AS x ON x.DocumentID = d.DocumentID
    JOIN ehd.Inspection AS i ON i.InspectionID = x.InspectionID
    JOIN ehd.Permit AS p ON p.PermitID = i.PermitID
    WHERE p.EntityId IS NOT NULL

    UNION ALL
    SELECT d.DocumentID, 'E', CONVERT(varchar(40), p.EntityId),
           CONVERT(bigint, p.EntityId), 'RegistrationApp'
    FROM ehd.Document AS d
    JOIN ehd.PermitDetailLUW AS x ON x.RegistrationAppID = d.DocumentID
    JOIN ehd.Permit AS p ON p.PermitID = x.PermitID
    WHERE p.EntityId IS NOT NULL

    UNION ALL
    SELECT d.DocumentID, 'E', CONVERT(varchar(40), p.EntityId),
           CONVERT(bigint, p.EntityId), 'CompletionReport'
    FROM ehd.Document AS d
    JOIN ehd.PermitDetailLUWWaterSource AS w ON w.CompletionReportID = d.DocumentID
    JOIN ehd.PermitDetailLUW AS l ON l.PermitDetailLUWId = w.PermitDetailLUWId
    JOIN ehd.Permit AS p ON p.PermitID = l.PermitID
    WHERE p.EntityId IS NOT NULL

    UNION ALL
    SELECT d.DocumentID, 'N', CONVERT(varchar(40), x.ComplaintID),
           NULL, 'Complaint'
    FROM ehd.Document AS d
    JOIN ehd.ComplaintDocument AS x ON x.DocumentID = d.DocumentID

    UNION ALL
    SELECT d.DocumentID, 'N', CONVERT(varchar(40), ci.ComplaintID),
           NULL, 'ComplaintInvestigation'
    FROM ehd.Document AS d
    JOIN ehd.ComplaintInvestigationDocument AS x ON x.DocumentID = d.DocumentID
    JOIN ehd.ComplaintInvestigation AS ci
        ON ci.ComplaintInvestigationID = x.ComplaintInvestigationID
),
Chosen AS
(
    SELECT *
    FROM Parents
    UNION ALL
    SELECT d.DocumentID, 'U', '', NULL, 'NoParent'
    FROM ehd.Document AS d
    WHERE NOT EXISTS
    (
        SELECT 1 FROM Parents AS p WHERE p.DocumentID = d.DocumentID
    )
)
SELECT
    d.DocumentID AS SourceDocumentID,
    c.SourceParentKind,
    c.SourceParentID,
    c.LegacyEntityID,
    d.FileName AS SourceFileName,
    CASE WHEN LOWER(LTRIM(RTRIM(d.FilePath))) = 'import process' THEN NULL
         ELSE d.FilePath END AS SourceFilePath,
    LEFT(d.FileName, 255) AS DocumentDescription,
    LEFT(CASE
            WHEN CHARINDEX('.', REVERSE(d.FileName)) &gt; 0
            THEN RIGHT(d.FileName, CHARINDEX('.', REVERSE(d.FileName)))
            ELSE ''
         END, 25) AS DocumentExtension,
    CASE
        WHEN ISNULL(d.IsEHD2Document, 0) = 1 THEN 'Ehd2Share'
        WHEN d.FilePath = 'import process' AND d.DocumentFile IS NOT NULL THEN 'SqlBlob'
        WHEN NULLIF(LTRIM(RTRIM(d.FilePath)), '') IS NOT NULL THEN 'FilePath'
        ELSE 'Other'
    END AS SourceContentKind,
    d.DocumentTypeID AS SourceDocumentTypeID,
    dt.DocumentType AS SourceDocumentTypeName,
    CASE
        WHEN d.FilePath = 'import process' AND d.DocumentFile IS NOT NULL
        THEN CONVERT(char(64), HASHBYTES('SHA2_256', d.DocumentFile), 2)
        ELSE NULL
    END AS ContentSHA256,
    CONVERT(bigint, COALESCE(DATALENGTH(d.DocumentFile), d.FileSize, 0)) AS ContentBytes,
    LEFT(d.CreatedBy, 100) AS SourceCreatedBy,
    CONVERT(datetime, d.DateCreated) AS SourceDateCreated,
    CONVERT(bit, ISNULL(d.Isarchived, 0)) AS IsArchived,
    CONVERT(bit, ISNULL(d.IsDeleted, 0)) AS IsDeleted,
    CONVERT(tinyint,
        CASE WHEN ISNULL(d.IsDeleted, 0) = 1 THEN 0
             WHEN ISNULL(d.Isarchived, 0) = 1 THEN 2
             ELSE 1 END) AS FileStatus,
    c.ParentRoute
FROM ehd.Document AS d
JOIN Chosen AS c ON c.DocumentID = d.DocumentID
LEFT JOIN lu.DocumentType AS dt ON dt.DocumentTypeID = d.DocumentTypeID;</property>
